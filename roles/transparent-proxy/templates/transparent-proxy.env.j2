# Managed by Ansible: transparent proxy env
PROXY_MODE={{ proxy_mode }}
PROXY_HOST={{ proxy_host }}
PROXY_PORT={{ proxy_port }}
PROXY_USERNAME={{ proxy_username }}
PROXY_PASSWORD={{ proxy_password }}
PROXY_EXPECTED_EGRESS_IP={{ proxy_expected_egress_ip }}

# Optional comma-separated public IPv4 addresses for legacy admin direct-routing and
# the experimental kill switch. Do not use this as the normal SSH reachability
# mechanism because developer source IPs can change. TCP/{{ proxy_ssh_port }}
# is bypassed by port in the rendered sing-box config.
ADMIN_IPS={{ proxy_admin_ips | join(',') }}
SSH_PORT={{ proxy_ssh_port }}

# DNS over TLS upstream used by sing-box DNS.
DNS_SERVER_IP={{ proxy_dns_server_ip }}
DNS_SERVER_PORT={{ proxy_dns_server_port }}
DNS_TLS_SERVER_NAME={{ proxy_dns_tls_server_name }}

# Keep RFC1918/local traffic direct.
DIRECT_PRIVATE_TRAFFIC={{ 'yes' if proxy_direct_private_traffic else 'no' }}

# Optional extra direct CIDRs, comma separated.
DIRECT_EXTRA_CIDRS="{{ proxy_direct_extra_cidrs | join(' ') }}"

# Set to yes only if the upstream proxy path really supports UDP.
PROXY_ALLOW_UDP={{ 'yes' if proxy_allow_udp else 'no' }}

# Reject IPv6 egress and disable host IPv6 by default to reduce leak paths.
ENABLE_IPV6_EGRESS={{ 'yes' if proxy_enable_ipv6_egress else 'no' }}
ENABLE_TUN_IPV6={{ 'yes' if proxy_enable_tun_ipv6 else 'no' }}

TUN_INTERFACE_NAME={{ proxy_tun_interface_name }}
TUN_IPV4_CIDR={{ proxy_tun_ipv4_cidr }}
TUN_IPV6_CIDR={{ proxy_tun_ipv6_cidr }}

SINGBOX_LOG_LEVEL={{ proxy_singbox_log_level }}

# Optional. Only used by the experimental kill switch workflow.
ENABLE_KILL_SWITCH={{ 'yes' if proxy_enable_killswitch else 'no' }}
